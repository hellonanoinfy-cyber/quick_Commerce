{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@/components/*": ["./src/components/*"],
      "@/lib/*": ["./src/lib/*"],
      "@/stores/*": ["./src/stores/*"],
      "@/hooks/*": ["./src/hooks/*"],
      "@/providers/*": ["./src/providers/*"],
      "@/utils/*": ["./src/lib/utils/*"],
      "@/constants/*": ["./src/lib/constants/*"],
      "@/validations/*": ["./src/lib/validations/*"]
    },
    "baseUrl": "."
  },
  "include": ["next-env.d.ts", "**/*.js", "**/*.jsx", "**/*.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
