# ══════════════════════════════════════════════════════════
# FirstCry — Environment variables (copy to .env for Docker)
# NEVER commit .env with real secrets.
# ══════════════════════════════════════════════════════════

# ── SQL Server ─────────────────────────────────────────
MSSQL_SA_PASSWORD=ChangeMe_Strong_Password_123!
DB_CONNECTION_STRING=Server=sqlserver;Database=FirstCryDb;User Id=sa;Password=ChangeMe_Strong_Password_123!;TrustServerCertificate=True;MultipleActiveResultSets=true

# ── Redis (optional — app falls back to in-memory if unavailable) ──
REDIS_CONNECTION_STRING=redis:6379,abortConnect=false

# ── JWT (required — min 32 random characters) ───────────
JWT_SECRET=replace_with_openssl_rand_hex_32_or_longer_secret_key
JWT_ISSUER=FirstCry
JWT_AUDIENCE=FirstCryApp
JWT_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# ── CORS (comma-separated frontend URLs) ────────────────
ALLOWED_ORIGINS=https://your-frontend-domain.com

# ── Admin seeding (comma-separated phones in E.164 format) ──
# Used by AdminUserSeeder on first DB bootstrap. Leave blank to seed a
# single placeholder admin you can promote later via tools/UpgradeAdminUser.ps1.
ADMIN_PHONE_NUMBERS=

# ── Resend SMTP (email OTP) ─────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MummaXpress
OTP_EMAIL_HASH_SECRET=

# ── MSG91 OTP (leave empty for demo/console OTP) ────────
SMS_MSG91_AUTH_KEY=
SMS_MSG91_TEMPLATE_ID=
SMS_MSG91_WHATSAPP_TEMPLATE_NAME=
SMS_MSG91_WHATSAPP_INTEGRATED_NUMBER=

# ── Razorpay (leave empty for demo payment modal) ───────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Meilisearch (optional) ─────────────────────────────
MEILI_MASTER_KEY=change_me
MEILI_URL=http://meilisearch:7700

# ── Cloudinary (optional) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend (build-time / runtime) ─────────────────────
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_APP_URL=https://your-frontend-domain.com
NEXT_PUBLIC_SIGNALR_URL=
API_INTERNAL_URL=http://backend:8080

# ── Database bootstrap (production: false) ─────────────
DATABASE_SEED_ON_STARTUP=false
